# Copy to .env (gitignored). Secrets only. Mode/allowlist live in .qqconnect.json
# (qqconnect config / setup, or ask Grok to get_settings / set_settings).
MAIL_USER=you@qq.com
MAIL_AUTH_CODE=

# Optional connection overrides
# MAIL_ACCOUNT_ID=qq
# MAIL_HOST=imap.qq.com
# MAIL_PORT=993
# MAIL_SMTP_HOST=smtp.qq.com
# MAIL_SMTP_PORT=465
# QQCONNECT_IMAP_ID=1

# Second mailbox (Grok Bot secret box: MAIL_USER_2 / MAIL_AUTH_CODE_2)
# MAIL_USER_2=work@163.com
# MAIL_AUTH_CODE_2=
# MAIL_ACCOUNT_ID_2=work

# Advanced: JSON addresses + auth codes in separate env vars
# QQCONNECT_ACCOUNTS=[{"id":"qq","address":"you@qq.com","authCodeEnv":"MAIL_AUTH_CODE"}]
